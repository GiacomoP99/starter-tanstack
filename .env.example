# Copy to .env.local and adjust.

# Base URL used by the axios instance (src/api/client.ts). Defaults to /api.
# Only set it if the browser must call the backend directly (needs CORS).
VITE_API_BASE_URL=

# Dev only: forward /api/* to a real backend (with mocks disabled), e.g.
# API_PROXY_TARGET=http://localhost:8080
# Set API_PROXY_STRIP_PREFIX=true if the backend paths don't start with /api.
API_PROXY_TARGET=

# MSW mocks are on by default in dev. Set to false to call the real backend.
VITE_ENABLE_MOCKS=true

# Swagger/OpenAPI spec used by `pnpm api:gen` (Orval). Not exposed to the app.
# OPENAPI_URL=http://localhost:8080/v3/api-docs
