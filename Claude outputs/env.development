# Committed dev defaults. Override locally in .env.local (git-ignored).

# Backend base URL used by the axios instance (src/api/client.ts).
# Leave empty to call the same origin (e.g. through a Vite dev proxy).
VITE_API_BASE_URL=

# Serve API responses from MSW mocks (dev only).
VITE_ENABLE_MOCKS=true
